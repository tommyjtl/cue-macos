// Shared build settings for Cue.
// Copy Local.xcconfig.example to Local.xcconfig and set your Apple Developer team ID.

#include "Version.xcconfig"
#include? "Local.xcconfig"

CODE_SIGN_STYLE = Automatic
MACOSX_DEPLOYMENT_TARGET = 15.6

// Xcode 16+ loads Swift code from Cue.debug.dylib by default. That dylib is
// re-signed on every build, so macOS TCC treats each run as a new app.
// Disable it so Screen Recording / Accessibility grants survive incremental builds.
ENABLE_DEBUG_DYLIB = NO
